# Application Configuration
NODE_ENV=development
PORT=5000
API_VERSION=v1

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/bonderudlaw
MONGODB_URI_TEST=mongodb://localhost:27017/bonderudlaw-test

# Security Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your-refresh-token-secret-change-this
JWT_REFRESH_EXPIRES_IN=30d

# Session Configuration
SESSION_SECRET=your-session-secret-change-this-in-production

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Email Configuration (for future use)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password
EMAIL_FROM=noreply@bonderudlaw.com

# File Upload Configuration
MAX_FILE_SIZE=5242880
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,application/pdf

# Logging Configuration
LOG_LEVEL=info
LOG_DIR=logs

# API Keys (for future integrations)
GOOGLE_MAPS_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Frontend URLs
CLIENT_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001

# Pagination Defaults
DEFAULT_PAGE=1
DEFAULT_LIMIT=10
MAX_LIMIT=100

# Cache Configuration
CACHE_TTL=3600
REDIS_URL=redis://localhost:6379

# Language Support
DEFAULT_LANGUAGE=en
SUPPORTED_LANGUAGES=en,fr

# Business Configuration
BUSINESS_NAME=Bonderud Law Firm
BUSINESS_EMAIL=info@bonderudlaw.com
BUSINESS_PHONE=+1-xxx-xxx-xxxx
BUSINESS_ADDRESS=123 Legal Street, City, Province, Postal Code