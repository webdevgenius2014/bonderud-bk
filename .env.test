# Test Environment Configuration
NODE_ENV=test
HOST=localhost
PORT=5001

# Test Database
MONGODB_URI=mongodb://localhost:27017/bonderud-test

# JWT Configuration
JWT_SECRET=test-jwt-secret-key-for-testing-only-32chars
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=test-refresh-secret-key-for-testing-32chars
JWT_REFRESH_EXPIRES_IN=30d

# Security
BCRYPT_SALT_ROUNDS=10
SESSION_SECRET=test-session-secret-key-for-testing-32chars
SESSION_MAX_AGE=86400000

# CORS
CORS_ORIGIN=http://localhost:3000
CORS_CREDENTIALS=true

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# API Configuration
API_PREFIX=/api
API_VERSION=v1

# Email Configuration (Mock for testing)
EMAIL_ENABLED=false
EMAIL_FROM=noreply@test.com
SMTP_HOST=smtp.test.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=test
SMTP_PASS=test

# File Upload
UPLOAD_MAX_FILE_SIZE=5242880
UPLOAD_ALLOWED_EXTENSIONS=jpg,jpeg,png,gif,pdf,doc,docx

# Logging
LOG_LEVEL=error
LOG_MAX_FILES=1d
LOG_DATE_PATTERN=YYYY-MM-DD

# Frontend URL
FRONTEND_URL=http://localhost:3000

# AWS S3 (Mock for testing)
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_REGION=us-east-1
AWS_S3_BUCKET=test-bucket